# URL backend REST API (server/index.js)
VITE_API_URL=http://localhost:3101

# Mapbox public token (awalan pk.) untuk reverse geocoding presensi.
# Gratis 100.000 request/bulan. Ambil token di https://account.mapbox.com/access-tokens/
# WAJIB batasi "URL restrictions" di dashboard Mapbox ke domain produksi.
# Kosongkan nilai ini untuk memakai Nominatim saja.
VITE_MAPBOX_TOKEN=

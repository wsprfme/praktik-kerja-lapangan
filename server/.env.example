# Backend SQLite memakai PORT 3101 agar tidak bentrok dengan service lain di VPS.
PORT=3101
DB_FILE=./db.sqlite
UPLOAD_DIR=./uploads

# WAJIB diisi: minimal 32 karakter. Generate dengan: openssl rand -base64 48
# Jangan pernah memakai nilai default di produksi.
JWT_SECRET=

# Masa berlaku token sesi.
TOKEN_TTL=12h

# Batas & tipe file yang boleh diunggah.
MAX_UPLOAD_BYTES=5242880

# Origin frontend yang diizinkan accessing API (pisahkan dengan koma).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Akun admin awal, hanya dipakai saat tabel users masih kosong.
SEED_ADMIN_EMAIL=admin@pkl.local
SEED_ADMIN_PASSWORD=
